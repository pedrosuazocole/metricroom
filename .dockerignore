# ============================================================
# MetricRoom — .dockerignore
# Excluye archivos pesados del contexto de build en Railway
# ============================================================

# Dependencias (se instalan dentro del contenedor)
node_modules/
frontend/node_modules/
backend/node_modules/

# Build previos
frontend/dist/
frontend/.vite/

# Base de datos local
backend/data/
*.db
*.db-shm
*.db-wal

# Variables de entorno locales
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Editor y OS
.DS_Store
.vscode/
.idea/
Thumbs.db

# Git
.git/
.gitignore

# Docker
docker-compose.yml
docker-compose.*.yml
