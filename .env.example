# ============================================================
# MetricRoom — Variables de Entorno
# Copia este archivo como .env y completa los valores
# ============================================================

# --- Servidor ---
PORT=3001
NODE_ENV=development

# --- Base de Datos SQLite ---
# En desarrollo local, la BD se crea en ./backend/data/metricroom.db
# En Railway, usar la ruta del volumen persistente: /data/metricroom.db
DATABASE_PATH=./data/metricroom.db

# --- Seguridad ---
# Cambia este valor por una cadena aleatoria larga en producción
JWT_SECRET=metricroom_secret_cambia_esto_en_produccion

# --- WhatsApp / CallMeBot (opcional) ---
# Se configura también desde la interfaz de Configuración
WHATSAPP_PHONE=+50498765432
WHATSAPP_APIKEY=tu_apikey_de_callmebot

# --- CORS (producción) ---
# Deja vacío para desarrollo local. En Railway se auto-detecta.
FRONTEND_URL=

# ============================================================
# INSTRUCCIONES PARA RAILWAY:
# 1. En Railway > Settings > Variables, agrega:
#    DATABASE_PATH=/data/metricroom.db
#    NODE_ENV=production
#    JWT_SECRET=<cadena-aleatoria-larga>
# 2. En Railway > Settings > Volumes, monta un volumen en /data
#    para que la base de datos SQLite persista entre deploys.
# ============================================================
